# LeadForge 环境变量模板 — 复制为 .env 后填写
# 创建时间: 2026-07-23

# ---- 服务端口 ----
LEADFORGE_WEB_PORT=8080
LITELLM_PORT=4000
QDRANT_PORT=6333
N8N_PORT=5678
TRENDRADAR_MCP_PORT=3333
PAPERCLIP_PORT=3100

# ---- TrendRadar sidecar（GPL，独立容器；本地开发可指向 127.0.0.1）----
# Docker 内 API 用 http://trendradar-mcp:3333/mcp；宿主机直连用下方默认
TRENDRADAR_MCP_URL=http://127.0.0.1:3333/mcp
TRENDRADAR_WEB_URL=http://127.0.0.1:8081
TRENDRADAR_WEB_PORT=8081
TRENDRADAR_RUN_MODE=cron
TRENDRADAR_CRON=*/30 * * * *
TRENDRADAR_IMMEDIATE_RUN=true

# ---- Paperclip sidecar（MIT；先 compose up paperclip，UI 建公司后填 ID）----
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=
PAPERCLIP_PROJECT_ID=
PAPERCLIP_GOAL_ID=
PAPERCLIP_AGENT_ID=
PAPERCLIP_API_KEY=
BETTER_AUTH_SECRET=
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100

# ---- 安全（本地 .env 填写；勿提交真实值）----
LEADFORGE_API_TOKEN=
LITELLM_MASTER_KEY=

# ---- Agnes 免费文本模型（推荐默认）----
AGNES_API_KEY=
AGNES_API_BASE=https://apihub.agnes-ai.com

# ---- 默认模型档位配置（可被控制台一键切换覆盖）----
MODEL_PROFILE=agnes-free
MOCK_LLM=false

# ---- 各厂商 API Key（按需填写，未填的档位会在 UI 标红）----
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

ANTHROPIC_API_KEY=

# 通义 / 兼容 OpenAI 的国内网关
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 本地 Ollama
OLLAMA_API_BASE=http://host.docker.internal:11434

# ---- 免费 LLM 资源（精选自 https://github.com/cheahjs/free-llm-api-resources ）----
# 控制台「免费模型」区可按厂商选模型；勿滥用限额
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN=
# 申请: https://github.com/settings/tokens （classic，勾选 public_repo 即可）
# 未配置时 GitHub Search 匿名约 10 次/小时，易 403；Trending HTML 不受影响
HF_TOKEN=
NVIDIA_API_KEY=
AI_GATEWAY_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FIREWORKS_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
NOVITA_API_KEY=
OPENCODE_API_KEY=
BASETEN_API_KEY=
NEBIUS_API_KEY=
AI21_API_KEY=
UPSTAGE_API_KEY=
NLPCLOUD_API_KEY=
# DASHSCOPE_API_KEY=  # 已在上方阿里云段；国际站 trial-alibaba-intl 复用
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
INFERENCE_API_KEY=
SCALEWAY_API_KEY=

# ---- 中国本土商机真实研究（禁止 mock）----
# 至少配置其一；推荐博查（本土）或 Serper(gl=cn)
BOCHA_API_KEY=
SERPER_API_KEY=
BING_SEARCH_API_KEY=
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
